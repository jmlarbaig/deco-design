---
import SectionHeading from './SectionHeading.astro';
import { REALISATIONS } from '../consts';
---

<section id="realisations" class="scroll-mt-24 border-b border-pale/10">
  <div class="mx-auto max-w-7xl px-6 pt-24 md:px-10 md:pt-32">
    <div class="flex items-end justify-between gap-6">
      <SectionHeading index="02" eyebrow="Nos chantiers" title="Réalisations" />
      <div class="reveal mb-14 hidden items-center gap-4 md:mb-20 md:flex">
        <p class="font-display text-lg font-light text-sage" aria-live="polite">
          <span id="carousel-index" class="font-medium text-pale">01</span>
          <span class="text-pale/30">/</span> {String(REALISATIONS.length).padStart(2, '0')}
        </p>
        <div class="flex gap-2">
          <button
            id="carousel-prev"
            aria-label="Photo précédente"
            class="flex h-11 w-11 items-center justify-center rounded-full border border-pale/20 bg-white/5 backdrop-blur transition-colors hover:border-lime hover:bg-lime hover:text-night disabled:opacity-30"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button
            id="carousel-next"
            aria-label="Photo suivante"
            class="flex h-11 w-11 items-center justify-center rounded-full border border-pale/20 bg-white/5 backdrop-blur transition-colors hover:border-lime hover:bg-lime hover:text-night disabled:opacity-30"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="pb-24 md:pb-32">
    <ul
      id="carousel"
      class="flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth px-6 [scrollbar-width:none] [mask-image:linear-gradient(to_right,transparent,black_4%,black_96%,transparent)] md:gap-8 md:px-10 [&::-webkit-scrollbar]:hidden"
    >
      {REALISATIONS.map((r) => (
        <li class="carousel-slide shrink-0 snap-center">
          <figure>
            <div class="h-[52svh] overflow-hidden rounded-2xl bg-night-soft ring-1 ring-pale/10 md:h-[66svh]">
              <img
                src={r.img}
                alt={r.alt}
                loading="lazy"
                decoding="async"
                draggable="false"
                class="h-full w-auto max-w-none object-cover"
              />
            </div>
            <figcaption class="mt-3 font-display text-sm font-light text-sage">
              <span class="font-medium text-lime">{r.num}</span> — Réalisation
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const track = document.getElementById('carousel') as HTMLElement | null;
  const slides = Array.from(track?.querySelectorAll('.carousel-slide') ?? []);
  const counter = document.getElementById('carousel-index');
  const prev = document.getElementById('carousel-prev') as HTMLButtonElement | null;
  const next = document.getElementById('carousel-next') as HTMLButtonElement | null;

  const currentIndex = () => {
    if (!track || slides.length === 0) return 0;
    const mid = track.scrollLeft + track.clientWidth / 2;
    let best = 0;
    let bestDist = Infinity;
    slides.forEach((s, i) => {
      const el = s as HTMLElement;
      const d = Math.abs(el.offsetLeft + el.offsetWidth / 2 - mid);
      if (d < bestDist) {
        bestDist = d;
        best = i;
      }
    });
    return best;
  };

  const sync = () => {
    const i = currentIndex();
    if (counter) counter.textContent = String(i + 1).padStart(2, '0');
    if (prev) prev.disabled = i === 0;
    if (next) next.disabled = i === slides.length - 1;
  };

  track?.addEventListener('scroll', sync, { passive: true });
  window.addEventListener('resize', sync);
  sync();

  const go = (dir: number) => {
    if (!track) return;
    const i = Math.min(Math.max(currentIndex() + dir, 0), slides.length - 1);
    const el = slides[i] as HTMLElement;
    track.scrollTo({ left: el.offsetLeft - (track.clientWidth - el.offsetWidth) / 2, behavior: 'smooth' });
  };
  prev?.addEventListener('click', () => go(-1));
  next?.addEventListener('click', () => go(1));

  // Glisser-défiler à la souris (desktop)
  let dragging = false;
  let startX = 0;
  let startScroll = 0;
  track?.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'mouse') return;
    dragging = true;
    startX = e.clientX;
    startScroll = track.scrollLeft;
    track.style.scrollSnapType = 'none';
    track.style.scrollBehavior = 'auto';
  });
  window.addEventListener('pointermove', (e) => {
    if (!dragging || !track) return;
    track.scrollLeft = startScroll - (e.clientX - startX);
  });
  window.addEventListener('pointerup', () => {
    if (!dragging || !track) return;
    dragging = false;
    track.style.scrollSnapType = '';
    track.style.scrollBehavior = '';
  });
</script>
