---
import Base from '../layouts/Base.astro';
import { BUSINESS } from '../consts';
---

<Base title={`Mentions légales | ${BUSINESS.name}`} description="Mentions légales du site Déco & Design, artisan plaquiste à Nay (64).">
  <section class="mx-auto max-w-3xl px-6 pb-20 pt-40">
    <h1 class="font-display text-4xl tracking-tight">Mentions légales</h1>

    <h2 class="mt-10 font-display text-2xl">Éditeur du site</h2>
    <p class="mt-3 leading-relaxed text-sage">
      {BUSINESS.name}<br />
      {BUSINESS.locality} ({BUSINESS.postalCode}), {BUSINESS.region}<br />
      Téléphone : <a href={BUSINESS.phoneHref} class="underline">{BUSINESS.phone}</a><br />
      Email : <a href={`mailto:${BUSINESS.email}`} class="underline">{BUSINESS.email}</a>
    </p>
    <!-- TODO: ajouter SIRET, forme juridique et nom du dirigeant -->

    <h2 class="mt-10 font-display text-2xl">Hébergement</h2>
    <p class="mt-3 leading-relaxed text-sage">
      Site hébergé par Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, États-Unis.
    </p>

    <h2 class="mt-10 font-display text-2xl">Données personnelles</h2>
    <p class="mt-3 leading-relaxed text-sage">
      Les informations transmises via le formulaire de contact sont utilisées uniquement pour
      répondre à votre demande de devis. Elles ne sont ni cédées ni revendues. Conformément au RGPD,
      vous pouvez demander leur suppression en écrivant à {BUSINESS.email}.
    </p>
  </section>
</Base>
